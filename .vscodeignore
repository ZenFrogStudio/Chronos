.vscode/**
.claude/**
.gitignore
.sandbox/**
# Chronos running on its own repository writes a real .chronos here: this
# folder's plans, transcripts, logs and schedule. `.chronos/.gitignore` keeps
# it out of git, but vsce reads this file and nothing else, so without this
# line every install ships one developer's private work.
.chronos/**
favicon.ico
# The landing page is repo-only — a static site Cloudflare Pages serves from
# GitHub. It must never ship inside the .vsix.
site/**
docs/**
test/**
src/**
dist-test/**
node_modules/**
esbuild.js
reinstall.js
tsconfig.json
tsconfig.test.json
**/*.map
**/*.ts
